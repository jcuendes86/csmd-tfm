{
  "name": "cars-prediction-api",
  "version": "1.0.0",
  "description": "API to get car price predictions from a BigQuery ML model.",
  "main": "dist/index.js",
  "scripts": {
    "build": "npm i && tsc",
    "clean": "rm -rf node_modules dist package-lock.json *.tgz || true",
    "clean-build": "npm run clean && npm run build",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "start:watch": "nodemon"
  },
  "author": "Jose Cuendes",
  "dependencies": {
    "@google-cloud/bigquery": "^8.1.1",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "nodemon": "^3.1.10",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.2"
  },
  "nodemonConfig": {
    "ignore": [
      "**/*.test.ts",
      "**/*.spec.ts",
      ".git",
      "node_modules"
    ],
    "watch": [
      "src"
    ],
    "exec": "node --inspect=5859 -r ts-node/register src/index.ts",
    "ext": "ts"
  }
}
